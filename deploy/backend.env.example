# ============================================================
# 后端运行时环境变量
#
# 用法：复制为 backend.env 后填入真实值
#   cp deploy/backend.env.example deploy/backend.env
#   chmod 600 deploy/backend.env
#
# backend.env 已被 .gitignore 忽略，不会被提交。
# ============================================================

# ---------- 运行 profile（覆盖 application.yml 里写死的 local） ----------
SPRING_PROFILES_ACTIVE=prod

# ---------- 数据库（复用宿主机已有的 MySQL 容器） ----------
MYSQL_USER=zw_app
MYSQL_PASSWORD=CHANGE_ME

# ---------- Redis（宿主机的 Redis，无密码则留空） ----------
REDIS_PASSWORD=

# ---------- 大模型（必填，否则 AI 生成相关功能不可用） ----------
DEEPSEEK_API_KEY=CHANGE_ME

# ---------- 腾讯云 COS（部署截图上传用，不配则截图上传失败） ----------
COS_HOST=https://CHANGE_ME.cos.ap-guangzhou.myqcloud.com
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
COS_BUCKET=CHANGE_ME

# ---------- AI 生成应用的对外访问地址 ----------
# 直接用 IP、无域名时填 http://<公网IP>/apps
# 注意：这个值目前还与 AppConstant.CODE_DEPLOY_HOST 有关，详见 docs/部署方案.md 第 2.3 节
CODE_DEPLOY_HOST=http://203.195.211.168/apps
