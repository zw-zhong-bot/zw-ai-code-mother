# 生产环境变量（IP 访问，暂无域名与 HTTPS）
#
# ⚠️ 这个文件是必需的。src/config/env.ts 里两个常量的回退值是硬编码的开发地址：
#      API_BASE_URL = VITE_API_BASE_URL || 'http://localhost:8123/api'
#      DEPLOY_DOMAIN = VITE_DEPLOY_DOMAIN || 'http://localhost'
#    缺少本文件时，构建产物会让浏览器去请求用户自己机器的 localhost:8123，线上必然白屏。
#
# 部署前替换：203.195.211.168 → 你的公网 IP
# 后续接入域名时，把两处换成 https://www.example.com，并在 nginx 里配 443 与证书即可。

# 用相对路径，由 nginx 反代到后端，避免域名硬编码与跨域
VITE_API_BASE_URL=/api

# AI 生成的应用部署后的对外地址前缀，对应 nginx 的 location /apps/
VITE_DEPLOY_DOMAIN=http://203.195.211.168/apps
