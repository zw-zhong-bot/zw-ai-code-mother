# 生产环境变量
#
# ⚠️ 这个文件是必需的。src/config/env.ts 里两个常量的回退值是硬编码的开发地址：
#      API_BASE_URL = VITE_API_BASE_URL || 'http://localhost:8123/api'
#      DEPLOY_DOMAIN = VITE_DEPLOY_DOMAIN || 'http://localhost'
#    缺少本文件时，构建产物会让浏览器去请求用户自己机器的 localhost:8123，线上必然白屏。
#
# 【当前策略：IP 入口为主，域名为备】
#   服务器在腾讯云广州（中国大陆），域名 zwdev.asia 目前状态为 `server hold`
#   （注册局锁定，原因通常是实名认证未完成），且备案未办理。
#   未备案域名解析到境内服务器会被备案监测拦截，因此暂不切换解析。
#
#   切域名时（备案通过后）只需改下面两行 + 重新构建前端，无需改代码：
#      VITE_API_BASE_URL=/api                          ← 保持相对路径，不用改
#      VITE_DEPLOY_DOMAIN=https://zwdev.asia/apps      ← 改成域名
#   同时后端 backend.env 的 CODE_DEPLOY_HOST 也要一起改（该值目前对代码无效，见 docs/部署方案.md §3.1）

# 用相对路径，由 nginx 反代到后端，避免域名硬编码与跨域。
# 相对路径的好处：无论用 IP 还是域名访问，前端都自动跟随当前来源，切域名时这一行不用动。
VITE_API_BASE_URL=/api

# AI 生成的应用部署后的对外地址前缀，对应 nginx 的 location /apps/
# 切域名后改成 https://zwdev.asia/apps
VITE_DEPLOY_DOMAIN=http://203.195.211.168/apps
